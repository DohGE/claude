{
  "description": "doh lean mode: gives every sub-agent of a session in which a doh skill ran the caveman ultra rules (shared/caveman-ultra.md). See shared/README.md. codeReview: while a review runs, checks every report part before it is written (skills/codeReview/scripts/check-part.cjs), refreshes the cross-file bundle before its Read, moves a refused part's fixed draft into place after an Edit, and after a compaction names where the run stands and what to read again (skills/codeReview/scripts/review-hooks.cjs); silent in every other session.",
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/lean-mode.cjs",
              "--event=subagent"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/codeReview/scripts/review-hooks.cjs",
              "--event=compact"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/codeReview/scripts/check-part.cjs"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/codeReview/scripts/review-hooks.cjs",
              "--event=read"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/codeReview/scripts/review-hooks.cjs",
              "--event=draft"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
